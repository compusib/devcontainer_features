{
    "dockerComposeFile": "compose.yml",
    "service": "devcontainer-features-dev",
    "workspaceFolder": "/workspace/compusib/devcontainer_features",
    "customizations": {
        "vscode": {
            "settings": {
                "json.schemas": [
                    {
                        "fileMatch": [
                            "*/devcontainer-feature.json"
                        ],
                        "url": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainerFeature.schema.json"
                    }
                ]
            },
            "extensions": [
                "mads-hartmann.bash-ide-vscode",
                "GitHub.vscode-pull-request-github",
                "mhutchie.git-graph",
                "Anthropic.claude-code"
            ]
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:2": {},
        "ghcr.io/compusib/devcontainer_features/bashrc:0": {
            // compusibBashRepoRoot defaults to /workspace/compusib/bash
            // "compusibBashRepoRoot": "/workspace/compusib/bash"
        },
        "ghcr.io/compusib/devcontainer_features/argbash:0": {},
        "ghcr.io/compusib/devcontainer_features/starship:latest": {},
        // The 'claude' feature lives at src/claude, outside .devcontainer/, so it cannot be
        // referenced by local path: the dev-containers spec requires a local Feature's source to
        // be a sub-folder of .devcontainer/, and a symlink there fails the copy step (the CLI uses
        // ncp, which won't dereference it). It is consumed via its published GHCR image instead.
        // Defaults match this environment. Test the source directly from the repo root with:
        //   devcontainer features test -f claude -i mcr.microsoft.com/devcontainers/base:ubuntu .
        "ghcr.io/compusib/devcontainer_features/claude:0": {
            "claudePlugins": "base-stack@compusib agent-skills@addy-agent-skills"
        }
    },
    "containerEnv": {
        "GIT_AUTHOR_NAME": "${localEnv:GIT_AUTHOR_NAME}",
		"GIT_AUTHOR_EMAIL": "${localEnv:GIT_AUTHOR_EMAIL}",
		"GITHUB_TOKEN": "${localEnv:GITHUB_TOKEN}",
		// Backblaze B2 credentials for `rcloneops` (claude data sync). Forwarded
		// from the host env; never commit real values here.
		"DEVCONTAINERS_B2_ACCOUNT": "${localEnv:DEVCONTAINERS_B2_ACCOUNT}",
		"DEVCONTAINERS_B2_KEY": "${localEnv:DEVCONTAINERS_B2_KEY}",
		"DEVCONTAINERS_B2_BUCKET": "${localEnv:DEVCONTAINERS_B2_BUCKET}",
		// TEMPORARY: remove once the bashrc feature sets BASH_REPO_ROOT itself
		"BASH_REPO_ROOT": "/workspace/compusib/bash",
		// Auto-trust the workspace's mise configs (mise.toml here), for interactive shells, the lifecycle
		// hooks and mise's shims alike.
		"MISE_TRUSTED_CONFIG_PATHS": "/workspace"
    },
    // mise's shims, for what VS Code starts outside an interactive shell (go, ssh-jwt). Interactive shells get
    // the tools from mise's activation (the bash repo's 115_mise.sh), which comes first on PATH.
    "remoteEnv": {
        "PATH": "${containerEnv:PATH}:/home/node/.local/share/mise/shims"
    },
    "remoteUser": "node",
    "updateContentCommand": "npm install -g @devcontainers/cli",
    // Installs the tools pinned in mise.toml: go and ssh-jwt, for pgtoken (src/auth/pgtoken) and its gates.
    // Run through bash, so it does not depend on the file's executable bit surviving the mount.
    "postCreateCommand": "bash .devcontainer/config/hooks/post-create.sh"
}